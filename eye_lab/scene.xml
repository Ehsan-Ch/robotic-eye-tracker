<mujoco model="robotic_eye">
  <compiler angle="radian"/>
  <option timestep=".002" integrator="implicitfast"/>
  <visual><headlight ambient=".45 .45 .45" diffuse=".7 .7 .7"/><global offwidth="640" offheight="480"/></visual>
  <default><geom friction=".8 .02 .002" rgba=".32 .42 .53 1"/><joint damping=".4" armature=".02"/></default>
  <asset>
    <texture type="skybox" builtin="gradient" rgb1=".08 .12 .18" rgb2=".28 .35 .42" width="128" height="128"/>
    <texture name="grid" type="2d" builtin="checker" rgb1=".2 .25 .3" rgb2=".3 .35 .4" width="128" height="128"/>
    <material name="ground" texture="grid" texrepeat="20 20"/>
  </asset>
  <worldbody>
    <light pos="0 0 5" dir="0 1 -1" diffuse=".8 .8 .8"/>
    <geom name="floor" type="plane" size="10 10 .1" material="ground"/>
    <geom name="base" type="cylinder" pos="0 0 .1" size=".3 .1" rgba=".12 .23 .31 1"/>
    <geom name="post" type="cylinder" pos="0 0 .59" size=".07 .4" rgba=".3 .4 .5 1"/>
    <body name="pan" pos="0 0 1.12">
      <joint name="pan_joint" axis="0 0 1" range="-1.35 1.35" limited="true"/>
      <geom type="box" size=".23 .10 .06" mass=".4" rgba=".2 .6 .65 1"/>
      <body name="eye" pos="0 0 .11">
        <joint name="tilt_joint" axis="1 0 0" range="-.65 .75" limited="true"/>
        <geom name="housing" type="sphere" size=".19" mass=".5" rgba=".9 .93 .95 1"/>
        <geom name="iris" type="cylinder" size=".09 .025" pos="0 .17 0" euler="1.570796 0 0" mass=".04" rgba=".03 .12 .18 1"/>
        <camera name="eye_camera" pos="0 .205 0" xyaxes="1 0 0 0 0 1" fovy="54"/>
      </body>
    </body>
    <body name="target" mocap="true" pos="0 3 1.2"><geom name="target_ball" type="sphere" size=".16" rgba=".95 .035 .055 1" contype="0" conaffinity="0"/></body>
    <body name="distractor" mocap="true" pos="1 3.5 1.4"><geom name="distractor_ball" type="sphere" size=".21" rgba=".04 .3 .9 1" contype="0" conaffinity="0"/></body>
    <body name="occluder" mocap="true" pos="0 1.8 -4"><geom name="screen" type="box" size=".6 .04 .7" rgba=".38 .45 .52 1" contype="0" conaffinity="0"/></body>
    <geom name="back_wall" type="box" pos="0 5.5 1.5" size="5 .05 1.5" rgba=".25 .32 .4 1"/>
  </worldbody>
  <actuator><position joint="pan_joint" kp="30" kv="4" ctrlrange="-1.35 1.35" ctrllimited="true" forcerange="-4 4" forcelimited="true"/><position joint="tilt_joint" kp="30" kv="4" ctrlrange="-.65 .75" ctrllimited="true" forcerange="-4 4" forcelimited="true"/></actuator>
</mujoco>
